# Public example only. Copy to .env for local private use.

HERMES_PORT=8790

# Demo data source for the current public build.
# Options:
# - fake_grafana
# - fake_application_api
# - application_api
HERMES_GRAFANA_SOURCE=fake_grafana

# Required only when HERMES_GRAFANA_SOURCE=application_api.
# Keep real private URLs in .env, never in committed files.
HERMES_APPLICATION_API_BASE_URL=http://localhost:8000
HERMES_APPLICATION_API_TIMEOUT_SECONDS=2.0

# Demo/default Grafana target. Replace only in your private .env file.
GRAFANA_URL=http://grafana:3000

# Never commit a real token. Use a Grafana service account token with Viewer permissions.
GRAFANA_TOKEN=replace_with_read_only_service_account_token
